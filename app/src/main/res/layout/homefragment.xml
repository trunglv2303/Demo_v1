<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:background="@color/primarybody"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/today"
            style="@style/Home.Body"
            android:textColor="?attr/colorPrimary" />

        <TextView
            style="@style/Home.Heading"
            android:layout_marginTop="4dp"
            android:accessibilityHeading="true"
            android:text="@string/home_title"
            android:textSize="32sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Home.Card"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#23346D"
            app:strokeWidth="0dp">

            <LinearLayout style="@style/Home.CardContent"
                android:background="@color/primarycolor"

                >

                <TextView
                    style="@style/Home.BalanceLabel"
                    android:text="@string/home_balance" />

                <TextView
                    style="@style/Home.BalanceValue"
                    android:layout_marginTop="4dp"
                    android:id="@+id/totalMoney"
                    android:text="@string/home_zero_amount"
                    android:textSize="34sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="#66CDD8FF"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Home.BalanceColumn"
                        android:layout_marginEnd="12dp">

                        <TextView
                            style="@style/Home.BalanceLabel"
                            android:text="@string/home_income" />


                        <TextView
                             android:id="@+id/totalincom"

                            style="@style/Home.BalanceValue"
                            android:text="@string/home_zero_amount"

                            android:textColor="#B4F5D3" />
                    </LinearLayout>

                    <LinearLayout style="@style/Home.BalanceColumn">

                        <TextView
                            style="@style/Home.BalanceLabel"
                            android:text="@string/home_expense" />

                        <TextView
                            android:id="@+id/totalexpresive"

                            style="@style/Home.BalanceValue"
                            android:text="@string/home_zero_amount"
                            android:textColor="#FFD4CA" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Home.Section"
            android:text="@string/home_tasks" />

        <com.google.android.material.card.MaterialCardView style="@style/Home.Card">

            <LinearLayout style="@style/Home.CardContent">

                <TextView
                    style="@style/Home.Heading"
                    android:text="@string/home_task_progress"
                    android:textSize="18sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progress="0"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    style="@style/Home.Body"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_no_tasks" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Home.Section"
            android:text="@string/home_recent_transactions" />

        <com.google.android.material.card.MaterialCardView style="@style/Home.Card">

            <LinearLayout
                style="@style/Home.CardContent"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/transaction"
/>
                <TextView
                    style="@style/Home.Body"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/home_no_transactions" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
