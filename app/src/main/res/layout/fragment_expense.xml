<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Home.Heading"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/transaction_title"
            android:textColor="@color/settings_text"
            android:textSize="28sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createTransaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/transaction_add"
            android:textAllCaps="false"
            android:contentDescription="@string/transaction_create"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_transaction_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ocean"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPreviousMonth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/transaction_previous_month"
                app:srcCompat="@drawable/ic_transaction_chevron"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Tháng 11/2026" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/transaction_next_month"
                android:rotation="180"
                app:srcCompat="@drawable/ic_transaction_chevron"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            style="@style/Home.BalanceLabel"
            android:layout_marginTop="2dp"
            android:text="@string/transaction_month_balance" />

        <TextView
            android:id="@+id/tvBalance"
            style="@style/Home.BalanceValue"
            android:layout_marginTop="2dp"
            android:textSize="28sp"
            tools:text="15.000 ₫" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/ocean_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Home.BalanceColumn"
                android:layout_marginEnd="8dp">

                <TextView
                    style="@style/Home.BalanceLabel"
                    android:text="@string/home_income" />

                <TextView
                    android:id="@+id/tvIncome"
                    style="@style/Home.BalanceValue"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    tools:text="30.000 ₫" />
            </LinearLayout>

            <LinearLayout
                style="@style/Home.BalanceColumn"
                android:layout_marginStart="8dp">

                <TextView
                    style="@style/Home.BalanceLabel"
                    android:text="@string/home_expense" />

                <TextView
                    android:id="@+id/tvExpenses"
                    style="@style/Home.BalanceValue"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    tools:text="15.000 ₫" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Home.Heading"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:accessibilityHeading="true"
        android:text="@string/transaction_history"
        android:textColor="@color/settings_text"
        android:textSize="18sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_transaction" />

    <TextView
        android:id="@+id/emptyTransactions"
        style="@style/Home.Body"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_month_selector"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/transaction_empty_month"
        android:textColor="@color/settings_text_secondary"
        android:visibility="gone" />
</LinearLayout>
