<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (chế độ tối). Màu chủ đạo: xanh primary -->
    <style name="Theme.DemoV1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primarycolor</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/primarybody</item>
        <!-- Secondary color -->
        <item name="colorSecondary">@color/primarycolor</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/primarybody</item>
        <!-- Status bar tối, chữ/icon sáng -->
        <item name="android:statusBarColor">@color/primarybody</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
